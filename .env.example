# Copy this to .env and fill in real values. .env is gitignored — never
# commit actual secrets.

# --- TiDB Cloud ---
# Exact connection string from the TiDB Cloud console (includes correct
# SSL params for the Serverless tier's TLS requirement).
DATABASE_URL=

# --- Clerk ---
# Dashboard -> API Keys.
CLERK_SECRET_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional: a specific Clerk user ID to always treat as super-admin, in
# addition to the SUPER_ADMIN_EMAILS list hardcoded in server/db.ts.
OWNER_CLERK_ID=

# Recommended for production. Read by server/_core/context.ts, so this
# belongs in Railway's env vars (the backend), not Vercel's -- Vercel only
# serves the static web build and never sees this value. Comma-separated
# list of parties allowed in a session token's `azp` claim -- e.g.
# https://your-app.vercel.app,https://your-custom-domain.com for the web
# frontend. Before setting a value for native (Android/iOS) sessions,
# verify what Clerk actually puts in `azp` for a real native token first
# -- don't assume it matches the app's URL scheme (app.config.ts) without
# checking; inspect the claim itself (never log/print the raw token).
# Left blank, the `azp` check is skipped entirely (fine for local dev;
# Clerk still verifies signature/expiry either way).
CLERK_AUTHORIZED_PARTIES=

# --- Backend URL (frontend -> backend) ---
# Local dev: http://localhost:3000. Production: the Railway URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Required in production. Read by server/_core/index.ts, so this belongs
# in Railway's env vars (the backend), not Vercel's -- Vercel only serves
# the static web build and never sees this value. Comma-separated origins
# allowed to call the API from a browser (localhost dev ports are allowed
# by default; nothing else is) -- e.g. https://your-app.vercel.app,
# https://your-custom-domain.com. Without this, no browser origin can
# reach the API once NODE_ENV=production.
CORS_ALLOWED_ORIGINS=

# --- Cloudinary ---
# Dashboard homepage -> account card. Only the server needs these; the
# client gets cloudName/apiKey back from the storage.getEliminationUploadSignature
# response, so no EXPO_PUBLIC_ Cloudinary var is needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
